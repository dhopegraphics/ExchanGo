{
  "expo": {
    "name": "ExchanGo",
    "slug": "ExchanGo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/exchanGoLogoWithBG.png",
    "scheme": "exchango",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/exchanGoLogoNoBg.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true ,
        "bundleIdentifier": "com.smarthivelabs.exchango",
         "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
        "package": "com.smarthivelabs.exchango",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/exchanGoLogoNoBg.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/exchanGoLogoNoBg.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-font",
      "expo-web-browser",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
